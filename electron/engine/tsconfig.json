{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["bun"],
    "paths": {
      "#engine/*": ["./src/*"],
      "@open-pencil/engine": ["./src/index.ts"],
      "@open-pencil/engine/interaction": ["./src/interaction/index.ts"],
      "@open-pencil/pen": ["../../packages/pen/src/index.ts"],
      "@open-pencil/pen/*": ["../../packages/pen/src/*"],
      "@open-pencil/session": ["../session/src/index.ts"],
      "@open-pencil/session/schema": ["../session/src/schema.ts"]
    }
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules"]
}
