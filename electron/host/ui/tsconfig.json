{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["bun"],
    "verbatimModuleSyntax": true
  },
  "include": ["./**/*.ts", "./**/*.vue", "./env.d.ts"]
}
